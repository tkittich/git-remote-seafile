# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
env/
venv/
ENV/
# A throwaway venv that review passes use to run a pinned ruff and pytest.  It
# ships a .gitignore of its own, but depending on that means deleting one file
# inside it turns `git status` into several thousand untracked entries (D10).
.review-venv/

# Testing & Coverage
.pytest_cache/
.coverage
# Parallel mode -- which pyproject.toml turns on for the whole suite, so that a
# worker process cannot overwrite the driver's data -- writes one file per
# process.  The plain `.coverage` above matches none of them.
.coverage.*
htmlcov/
unittest-output.txt
coverage-report.txt

# Linter cache
# Same reasoning as .review-venv/: ruff writes its own .gitignore, and relying
# on it makes the ignore rule invisible from the repository's own .gitignore.
.ruff_cache/

# Logs & temp
*.log
*.tmp
*.bak
_probe/
scratch/

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Local forensics, private audits & AI assistant memory
REVIEW*.md
PROPOSALS.md
archive/
.workbuddy-ai/
# `tools/` holds developer and diagnostic tooling that ships with the source
# distribution: the parallel test runner, the docs-guard verifier, and the
# Seafile sync-client doctor.  Each is named in MANIFEST.in, and each has tests
# under tests/ -- the doctor's ship-or-drop question (#24) was answered by
# writing those rather than by leaving it out of the repository.

# Credentials & environment tokens
.git-seafile.json
*.token
.env
.env.*
