# What goes into the source distribution.
#
# README.md and LICENSE arrive on their own, because pyproject.toml names them in
# `readme` and `license`.  Nothing else does.  A built sdist turned out to
# contain the package, the tests, and no user guide, no CHANGELOG, no DESIGN and
# no launcher -- a source distribution that omits its own documentation.

include LICENSE
include README.md
include CHANGELOG.md
include USER_GUIDE.md
include SNAPSHOT_GUIDE.md
include UPGRADING.md
include ALTERNATIVES.md
include DESIGN.md
include SECURITY.md
include RUNBOOK.md
include CONTRIBUTING.md
include ROADMAP.md
include SNAPSHOT.md
include PAYLOAD.md
include CODE_OF_CONDUCT.md
include pyproject.toml

# The typing marker (PEP 561): without it a downstream type checker reads
# this package as untyped while CONTRIBUTING.md asks contributors to
# annotate every signature (ROADMAP S16).  The docs guard checks that the
# manifest names nothing git does not track, so a marker added here without
# being committed fails the suite.
include git_remote_seafile/py.typed

# The source-checkout launcher, so an sdist can be run without installing it.
recursive-include bin *

# The suite, so a downstream packager can build from the sdist and still run the
# tests.  It used to arrive by accident, via a stale egg-info SOURCES.txt in a
# developer's working tree -- precisely the kind of accident that stops
# happening on a clean CI checkout.
recursive-include tests *.py

# Developer and diagnostic tooling that CONTRIBUTING.md and the README tell
# people to run.  Named individually rather than grafted so that anything added
# to tools/ has to be listed on purpose -- and so that a stray local file in
# someone's working copy cannot reach a release just by sitting there.
include tools/run_tests_parallel.py
include tools/verify_docs_guards.py
include tools/seafile_doctor.py
include tools/seafile_snapshot.py
include tools/build_snapshot.py
include tools/gates.py
recursive-include tools/_snapshot *.py

# CHANGELOG.md and ROADMAP.md link the desktop-client patch; an sdist that
# ships the links should ship what they point at.
include contrib/seafile-client-context-menu.patch

global-exclude *.py[cod]
